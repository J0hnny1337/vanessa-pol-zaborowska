# Kopia do .env (lokalnie) albo ustawienia projektu w Vercel (Settings → Environment Variables).

# Tajny klucz Payload: długi losowy ciąg, np. `openssl rand -hex 32`. Na produkcji nie zmieniaj go po starcie.
PAYLOAD_SECRET=

# Lokalnie: plik SQLite. Na Vercelu: adres Postgres z Neon (pooled connection string, zaczyna się od postgres://).
DATABASE_URI=file:./payload.db

# Tylko Vercel: token magazynu zdjęć (Storage → Blob). Vercel dodaje go sam po utworzeniu magazynu.
BLOB_READ_WRITE_TOKEN=

# Tylko produkcja: pełny adres strony, np. https://vanessa-pol.pl (włącza ochronę CSRF/CORS panelu).
NEXT_PUBLIC_SERVER_URL=

# Tylko dla `npm run seed`: konto administratora utworzone przy wgrywaniu treści.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

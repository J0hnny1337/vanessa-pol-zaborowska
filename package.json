{
  "name": "painter-site-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "seed": "tsx --env-file=.env src/seed/run.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "ci": "payload migrate && next build"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/db-sqlite": "^3.90.2",
    "@payloadcms/live-preview-react": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-vercel-blob": "^3.90.2",
    "@payloadcms/translations": "^3.90.2",
    "graphql": "^16.14.2",
    "next": "^16.3.8",
    "payload": "^3.90.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9"
  }
